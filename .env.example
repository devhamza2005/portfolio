# ═══════════════════════════════════════════════════════════════════════════
#  PORTFOLIO HAMZA FANOUNE — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════
#
#  LOCAL      : copier ce fichier en `.env` et renseigner les valeurs.
#  PRODUCTION : reporter ces mêmes variables dans Vercel →
#               Project Settings → Environment Variables.
#
#  ⚠️ Ce fichier ne contient QUE des exemples. Aucune valeur réelle ici :
#     `.env` est ignoré par git, `.env.example` est versionné.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1. BASE DE DONNÉES — Neon PostgreSQL                            [REQUIS]
# ───────────────────────────────────────────────────────────────────────────
#
#  Où trouver ces valeurs :
#    https://console.neon.tech → votre projet → Connection Details
#    Cocher « Show password », puis copier les deux chaînes :
#
#    • DATABASE_URL        → connexion POOLÉE (l'hôte contient « -pooler »)
#                            Utilisée par l'application à chaque requête.
#    • DIRECT_DATABASE_URL → connexion DIRECTE (sans « -pooler »)
#                            Utilisée par les migrations et le seed : le
#                            pooler ne supporte pas les commandes DDL longues.
#
#  Les deux doivent conserver `?sslmode=require` — Neon refuse le clair.
#
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@ep-exemple-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@ep-exemple-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

#  Facultatif — base « fantôme » utilisée par `prisma migrate dev` pour
#  détecter les dérives de schéma. Neon en crée une automatiquement ;
#  ne renseigner que si Prisma signale un défaut de permissions.
# SHADOW_DATABASE_URL=""


# ───────────────────────────────────────────────────────────────────────────
#  2. AUTHENTIFICATION — Auth.js v5                                [REQUIS]
# ───────────────────────────────────────────────────────────────────────────
#
#  Générer un secret :  npx auth secret
#  (ou : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
#
#  ⚠️ Utiliser un secret DIFFÉRENT en production. Changer AUTH_SECRET
#     déconnecte immédiatement toutes les sessions ouvertes.
#
AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-octets-minimum"

#  URL publique du site, sans slash final.
#  Local      : http://localhost:3000
#  Production : https://votre-domaine.com
AUTH_URL="http://localhost:3000"


# ───────────────────────────────────────────────────────────────────────────
#  3. COMPTE ADMINISTRATEUR INITIAL                                [REQUIS]
# ───────────────────────────────────────────────────────────────────────────
#
#  Lues UNIQUEMENT par `npm run db:seed`, au premier amorçage.
#  Le seed ne réécrit jamais le mot de passe d'un compte déjà créé.
#
#  ⚠️ Choisir un mot de passe fort : ce compte donne accès à tout le contenu
#     du portfolio. Le changer ensuite depuis /admin/settings.
#
ADMIN_EMAIL="vous@exemple.com"
ADMIN_PASSWORD="remplacer-par-un-mot-de-passe-fort"
ADMIN_NAME="Prénom Nom"


# ───────────────────────────────────────────────────────────────────────────
#  4. STOCKAGE DES IMAGES — Cloudinary            [REQUIS EN PRODUCTION]
# ───────────────────────────────────────────────────────────────────────────
#
#  Valeurs acceptées pour STORAGE_PROVIDER :
#    • cloudinary → images envoyées sur Cloudinary (CDN, optimisation auto)
#    • local      → images écrites dans public/uploads
#
#  ⚠️ SUR VERCEL, « local » NE FONCTIONNE PAS.
#     Le système de fichiers y est éphémère : toute image téléversée
#     disparaîtrait au redéploiement suivant. En production :
#     STORAGE_PROVIDER=cloudinary et les trois clés ci-dessous renseignées.
#
#  Repli de sécurité : si le fournisseur est « cloudinary » mais que les clés
#  sont absentes, l'application bascule automatiquement sur le disque local
#  et affiche un avertissement dans /admin/media plutôt que d'échouer.
#
#  Où trouver ces valeurs :
#    https://console.cloudinary.com → Dashboard → API Keys
#    (« Cloud Name », « API Key », puis « Reveal » pour « API Secret »)
#
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

#  Dossier racine dans la médiathèque Cloudinary.
#  Les sous-dossiers (projects, certifications, logos…) sont créés seuls.
CLOUDINARY_FOLDER="portfolio-hamza"

#  ⚠️ CLOUDINARY_API_SECRET ne doit JAMAIS être préfixé de NEXT_PUBLIC_ :
#     il serait alors inclus dans le bundle envoyé au navigateur.
#     Le téléversement est signé côté serveur, aucun preset public n'est utilisé.


# ───────────────────────────────────────────────────────────────────────────
#  5. EMAIL — formulaire de contact                            [FACULTATIF]
# ───────────────────────────────────────────────────────────────────────────
#
#  Sans clé Resend, les messages restent enregistrés en base et consultables
#  dans /admin/messages. Aucune prise de contact n'est perdue.
#
#  https://resend.com/api-keys
#
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="portfolio@resend.dev"
CONTACT_TO_EMAIL="vous@exemple.com"


# ───────────────────────────────────────────────────────────────────────────
#  6. SITE                                                          [REQUIS]
# ───────────────────────────────────────────────────────────────────────────
#
#  Sert aux URL canoniques, au sitemap et aux images de partage (Open Graph).
#  Seule variable exposée au navigateur — elle ne contient rien de sensible.
#
#  Local      : http://localhost:3000
#  Production : https://votre-domaine.com   (sans slash final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ═══════════════════════════════════════════════════════════════════════════
#  DÉPLOIEMENT VERCEL — mémo
# ═══════════════════════════════════════════════════════════════════════════
#
#  1. Déclarer TOUTES les variables ci-dessus dans Vercel
#     (Production, Preview et Development).
#
#  2. Adapter à la production :
#       AUTH_URL              → https://votre-domaine.com
#       NEXT_PUBLIC_SITE_URL  → https://votre-domaine.com
#       AUTH_SECRET           → un secret distinct de celui du local
#       STORAGE_PROVIDER      → cloudinary  (obligatoire)
#
#  3. Appliquer les migrations sur la base Neon AVANT le premier
#     déploiement, depuis votre machine :
#       npm run db:deploy     (prisma migrate deploy)
#       npm run db:seed       (une seule fois, pour le contenu initial)
#
#     Alternative : ajouter `prisma migrate deploy` à la commande de build
#     Vercel pour que chaque déploiement applique les migrations en attente.
#
#  4. `npm run build` interroge la base pour prégénérer les pages :
#     la base Neon doit être joignable pendant le build.
# ═══════════════════════════════════════════════════════════════════════════
