# ─────────────────────────────────────────────────────────────
#  PORTFOLIO HAMZA FANOUNE — Variables d'environnement
#  Copier ce fichier en `.env` et remplir les valeurs.
#  Le fichier `.env` ne doit JAMAIS être commité.
# ─────────────────────────────────────────────────────────────

# ── BASE DE DONNÉES (Neon Postgres) ──────────────────────────
# https://console.neon.tech → Project → Connection string
# DATABASE_URL      : connexion poolée (utilisée par l'application)
# DIRECT_DATABASE_URL : connexion directe (utilisée par les migrations Prisma)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── AUTHENTIFICATION (Auth.js v5) ────────────────────────────
# Générer un secret : npx auth secret   (ou : openssl rand -base64 32)
AUTH_SECRET="remplacer-par-un-secret-aleatoire-de-32-octets-minimum"
# URL publique du site (sans slash final)
AUTH_URL="http://localhost:3000"

# ── COMPTE ADMIN INITIAL (utilisé uniquement par `npm run db:seed`) ──
# Après le premier seed, le mot de passe se change depuis /admin/settings.
ADMIN_EMAIL="devhamza2005@gmail.com"
ADMIN_PASSWORD="ChangeMoi!2026"
ADMIN_NAME="Hamza Fanoune"

# ── STOCKAGE DES IMAGES ──────────────────────────────────────
# Fournisseur : cloudinary | local
STORAGE_PROVIDER="cloudinary"
# https://console.cloudinary.com → Dashboard → API keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="portfolio-hamza"

# ── EMAIL (formulaire de contact) — OPTIONNEL ────────────────
# Sans clé Resend, les messages sont uniquement stockés en base
# et consultables dans /admin/messages.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="portfolio@resend.dev"
CONTACT_TO_EMAIL="devhamza2005@gmail.com"

# ── SITE ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
